{
  "expo": {
    "name": "Subasta",
    "slug": "subasta",
    "scheme": "subasta",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "mx.utslrc.subasta",
      "permissions": [
        "CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "mx.utslrc.subasta",
      "supportsTablet": false,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Se usa la cámara para fotografiar productos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se usa tu galería para adjuntar una foto del producto.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "684a18e8-5e41-4462-9be5-cc113413e43e"
      }
    },
    "owner": "utslrc"
  }
}
