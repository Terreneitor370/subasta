{
  "expo": {
    "name": "Subasta",
    "slug": "subasta",
    "scheme": "subasta",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "mx.utslrc.subasta",
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "ios": {
      "bundleIdentifier": "mx.utslrc.subasta",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        { "cameraPermission": "Se usa la camara para fotografiar productos y escanear codigos QR." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Se usa tu ubicacion para registrar tus ofertas y mostrar subastas cercanas." }
      ],
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        { "merchantIdentifier": "merchant.mx.utslrc.subasta", "enableGooglePay": false }
      ]
    ],
    "extra": {
      "eas": { "projectId": "REEMPLAZAR_CON_eas_init" }
    }
  }
}
