{
  "expo": {
    "name": "Subasta",
    "slug": "subasta",
    "scheme": "subasta",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "mx.utslrc.subasta",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "mx.utslrc.subasta",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Se usa la camara para fotografiar productos y escanear codigos QR."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se usa tu ubicacion para registrar tus ofertas y mostrar subastas cercanas."
        }
      ],
      "expo-notifications",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "684a18e8-5e41-4462-9be5-cc113413e43e"
      }
    },
    "owner": "fersho.zav"
  }
}
